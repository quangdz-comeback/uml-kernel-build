+static int __init memdrop_late_init(void)
+{
+	if (!IS_ENABLED(CONFIG_CONTIG_ALLOC)) {
+		os_warn("memdrop: CONFIG_CONTIG_ALLOC missing, disabled\n");
+		memdrop_mode = 0;
+		return 0;
+	}
+
+	/*
+	 * Cover all possible page-frame numbers the buddy may free.
+	 * max_pfn is final after mem_init setup paths; use max_low_pfn
+	 * which UML sets in arch_mm_preinit / setup_physmem.
+	 */
+	memdrop_nbits = max_pfn ? max_pfn : max_low_pfn;
+	if (memdrop_nbits < 1024)
+		memdrop_nbits = 1024;
+
+	memdrop_bitmap = bitmap_zalloc(memdrop_nbits, GFP_KERNEL);
+	if (!memdrop_bitmap) {
+		os_warn("memdrop: bitmap alloc failed, disabled\n");
+		memdrop_mode = 0;
+		return 0;
+	}
+
+	if (memdrop_mode == 2)
+		os_info("memdrop: on (PFN bitmap, contig-isolate)\n");
+	else if (memdrop_mode)
+		os_info("memdrop: batch (1MiB / 100ms, PFN bitmap+contig)\n");
+	else
+		os_info("memdrop: disabled\n");
+
+	memdrop_ready = true;
+	return 0;
+}
+late_initcall(memdrop_late_init);
+
+void arch_free_page(struct page *page, int order)
+{
+	unsigned long pfn, i, nr;
+	long set;
+
+	if (!memdrop_mode || !memdrop_ready || !memdrop_bitmap)
+		return;
+	if (this_cpu_read(memdrop_in_worker))
+		return;
+
+	pfn = page_to_pfn(page);
+	nr = 1UL << order;
+
+	for (i = 0; i < nr; i++) {
+		unsigned long p = pfn + i;
+
+		if (p >= memdrop_nbits)
+			break;
+		if (!test_and_set_bit(p, memdrop_bitmap))
+			atomic_long_inc(&memdrop_set_pages);
+	}
+
+	set = atomic_long_read(&memdrop_set_pages);
+	if (memdrop_mode == 2 || set >= MEMDROP_BATCH_PAGES)
+		memdrop_schedule(true);
+	else
+		memdrop_schedule(false);
+}
+
+static int __init uml_memdrop_setup(char *line, int *add)
+{
+	*add = 0;
+
+	if (!strcmp(line, "off"))
+		memdrop_mode = 0;
+	else if (!line[0] || !strcmp(line, "on"))
+		memdrop_mode = 2;
+	else if (!strcmp(line, "batch"))
+		memdrop_mode = 1;
+	else {
+		os_warn("memdrop: invalid '%s', using batch\n", line);
+		memdrop_mode = 1;
+	}
+	return 0;
+}
+__uml_setup("memdrop=", uml_memdrop_setup,
+"memdrop=off\n"
+"    Do not return free guest pages to the host.\n"
+"memdrop=batch\n"
+"    Default. Mark freed PFNs in a bitmap; after ~1MiB or 100ms, contig-\n"
+"    isolate still-free pages, MADV_REMOVE, return to freelist.\n"
+"memdrop=on\n"
+"    Same bitmap path, but schedule a flush on every free.\n\n"
+);
+
