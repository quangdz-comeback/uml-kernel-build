+/*
+ * memdrop: return freed guest physmem to the host via MADV_REMOVE.
+ *
+ * arch_free_page() only enqueues under a spinlock (no host syscalls on the
+ * free hot path). A delayed-work worker copies out the queue, drops the
+ * lock (IRQs enabled), then issues merged MADV_REMOVE calls.
+ *
+ * Default ("batch"):
+ *   - flush when >= 1MiB is pending, or
+ *   - flush when a free of order >= 4 (64KiB) arrives, or
+ *   - flush after ~100ms with anything pending
+ * memdrop=on   : schedule flush on every free (still via workqueue)
+ * memdrop=off  : disabled
+ * memdrop=<n>  : batch, but force-flush schedule when order >= n
+ */
+#define MEMDROP_MAX_RANGES	256
+#define MEMDROP_BATCH_BYTES	(1UL << 20)	/* 1 MiB */
+#define MEMDROP_DELAY		(HZ / 10)	/* 100 ms */
+
+struct memdrop_range {
+	unsigned long addr;
+	unsigned long len;
+};
+
+static int memdrop_mode = 1; /* 0=off, 1=batch, 2=on */
+static int memdrop_eager_order = 4;
+static bool memdrop_ready;
+
+static struct memdrop_range memdrop_ranges[MEMDROP_MAX_RANGES];
+static int memdrop_nr;
+static unsigned long memdrop_pending;
+static DEFINE_SPINLOCK(memdrop_lock);
+
+static void memdrop_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(memdrop_dwork, memdrop_work_fn);
+
+static void memdrop_schedule(bool immediate)
+{
+	if (!memdrop_ready || !memdrop_mode)
+		return;
+	/*
+	 * mod_delayed_work is IRQ-safe. Prefer queue_delayed_work when idle
+	 * so we do not constantly push the timer out on every free.
+	 */
+	if (immediate)
+		mod_delayed_work(system_wq, &memdrop_dwork, 0);
+	else if (!delayed_work_pending(&memdrop_dwork))
+		queue_delayed_work(system_wq, &memdrop_dwork, MEMDROP_DELAY);
+}
+
+static void memdrop_do_remove(unsigned long addr, unsigned long len)
+{
+	/* os_drop_memory takes an int length; chunk if needed. */
+	while (len) {
+		int chunk = (len > (unsigned long)INT_MAX) ?
+			INT_MAX : (int)len;
+		int err = os_drop_memory((void *)addr, chunk);
+
+		if (unlikely(err)) {
+			printk(KERN_WARNING
+			       "memdrop: MADV_REMOVE failed at 0x%lx len %d: %d - disabling\n",
+			       addr, chunk, err);
+			memdrop_mode = 0;
+			return;
+		}
+		addr += chunk;
+		len -= chunk;
+	}
+}
+
+static void memdrop_work_fn(struct work_struct *work)
+{
+	struct memdrop_range local[MEMDROP_MAX_RANGES];
+	int n, i;
+	bool again = false;
+
+	spin_lock_irq(&memdrop_lock);
+	n = memdrop_nr;
+	if (n) {
+		memcpy(local, memdrop_ranges, n * sizeof(local[0]));
+		memdrop_nr = 0;
+		memdrop_pending = 0;
+	}
+	spin_unlock_irq(&memdrop_lock);
+
+	for (i = 0; i < n && memdrop_mode; i++)
+		memdrop_do_remove(local[i].addr, local[i].len);
+
+	spin_lock_irq(&memdrop_lock);
+	if (memdrop_mode && memdrop_nr)
+		again = true;
+	spin_unlock_irq(&memdrop_lock);
+
+	if (again)
+		mod_delayed_work(system_wq, &memdrop_dwork, 0);
+}
+
+static void memdrop_queue(unsigned long addr, unsigned long len, int order)
+{
+	unsigned long flags;
+	bool immediate = false;
+	int i;
+
+	if (!memdrop_mode || !len)
+		return;
+
+	spin_lock_irqsave(&memdrop_lock, flags);
+
+	if (!memdrop_mode)
+		goto out;
+
+	/* Merge into an existing adjacent/overlapping range if possible. */
+	for (i = 0; i < memdrop_nr; i++) {
+		unsigned long a = memdrop_ranges[i].addr;
+		unsigned long e = a + memdrop_ranges[i].len;
+		unsigned long ne = addr + len;
+
+		if (ne < a || addr > e)
+			continue;
+		if (addr < a)
+			a = addr;
+		if (ne > e)
+			e = ne;
+		memdrop_pending -= memdrop_ranges[i].len;
+		memdrop_ranges[i].addr = a;
+		memdrop_ranges[i].len = e - a;
+		memdrop_pending += memdrop_ranges[i].len;
+		goto queued;
+	}
+
+	if (memdrop_nr >= MEMDROP_MAX_RANGES) {
+		/* Queue full: kick worker; this free is not tracked. */
+		immediate = true;
+		goto out;
+	}
+
+	memdrop_ranges[memdrop_nr].addr = addr;
+	memdrop_ranges[memdrop_nr].len = len;
+	memdrop_nr++;
+	memdrop_pending += len;
+
+queued:
+	if (memdrop_mode == 2 ||
+	    order >= memdrop_eager_order ||
+	    memdrop_pending >= MEMDROP_BATCH_BYTES ||
+	    memdrop_nr >= (MEMDROP_MAX_RANGES * 3 / 4))
+		immediate = true;
+
+out:
+	spin_unlock_irqrestore(&memdrop_lock, flags);
+	memdrop_schedule(immediate);
+}
+
 /* Used during early boot */
 static unsigned long brk_end;
 
