+static int __init memdrop_late_init(void)
+{
+#ifndef CONFIG_CONTIG_ALLOC
+	os_warn("memdrop: CONFIG_CONTIG_ALLOC missing, disabled\n");
+	memdrop_mode = 0;
+#endif
+	if (!memdrop_mode)
+		os_info("memdrop: disabled\n");
+	else if (memdrop_mode == 2)
+		os_info("memdrop: on (PFN queue, contig-isolate, workqueue)\n");
+	else
+		os_info("memdrop: batch (1MiB / 100ms, PFN+contig isolate)\n");
+
+	memdrop_ready = true;
+	return 0;
+}
+late_initcall(memdrop_late_init);
+
+/*
+ * Record the freed PFN for later host give-back. Do not punch here: the
+ * page re-enters the freelist immediately after we return.
+ */
+void arch_free_page(struct page *page, int order)
+{
+	if (!memdrop_mode || !memdrop_ready)
+		return;
+
+	memdrop_enqueue(page_to_pfn(page), 1U << order);
+}
+
+static int __init uml_memdrop_setup(char *line, int *add)
+{
+	*add = 0;
+
+	if (!strcmp(line, "off"))
+		memdrop_mode = 0;
+	else if (!line[0] || !strcmp(line, "on"))
+		memdrop_mode = 2;
+	else if (!strcmp(line, "batch"))
+		memdrop_mode = 1;
+	else {
+		os_warn("memdrop: invalid '%s', using batch\n", line);
+		memdrop_mode = 1;
+	}
+	return 0;
+}
+__uml_setup("memdrop=", uml_memdrop_setup,
+"memdrop=off\n"
+"    Do not return free guest pages to the host.\n"
+"memdrop=batch\n"
+"    Default. Queue freed PFNs; after ~1MiB or 100ms, contig-isolate still-\n"
+"    free pages, MADV_REMOVE their host backing, return them to freelist.\n"
+"memdrop=on\n"
+"    Same PFN path, but schedule a flush on every free.\n\n"
+);
+
 #if IS_ENABLED(CONFIG_ARCH_REUSE_HOST_VSYSCALL_AREA)
 /*
  * Create a page table and place a pointer to it in a middle page
