+static int __init memdrop_late_init(void)
+{
+	if (!memdrop_mode)
+		os_info("memdrop: disabled\n");
+	else if (memdrop_mode == 2)
+		os_info("memdrop: on (flush free pages via workqueue)\n");
+	else
+		os_info("memdrop: batch (1MiB credit / 100ms, safe isolate)\n");
+
+	memdrop_ready = true;
+	return 0;
+}
+late_initcall(memdrop_late_init);
+
+/*
+ * Count freed pages and schedule a host give-back. Must not punch `page`
+ * asynchronously: it is about to re-enter the freelist and may be reused
+ * before a delayed worker runs.
+ */
+void arch_free_page(struct page *page, int order)
+{
+	unsigned long nr;
+
+	if (!memdrop_mode || !memdrop_ready)
+		return;
+
+	nr = 1UL << order;
+	if (atomic_long_add_return(nr, &memdrop_credit) >= MEMDROP_BATCH_PAGES ||
+	    memdrop_mode == 2)
+		memdrop_schedule(true);
+	else
+		memdrop_schedule(false);
+}
+
+static int __init uml_memdrop_setup(char *line, int *add)
+{
+	*add = 0;
+
+	if (!strcmp(line, "off"))
+		memdrop_mode = 0;
+	else if (!line[0] || !strcmp(line, "on"))
+		memdrop_mode = 2;
+	else if (!strcmp(line, "batch"))
+		memdrop_mode = 1;
+	else {
+		os_warn("memdrop: invalid '%s', using batch\n", line);
+		memdrop_mode = 1;
+	}
+	return 0;
+}
+__uml_setup("memdrop=", uml_memdrop_setup,
+"memdrop=off\n"
+"    Do not return free guest pages to the host.\n"
+"memdrop=batch\n"
+"    Default. After frees accumulate to ~1MiB (or after 100ms), temporarily\n"
+"    isolate free pages, MADV_REMOVE their host backing, and free them back.\n"
+"memdrop=on\n"
+"    Same isolate path, but schedule a flush on every free kick.\n\n"
+);
+
