+static int __init memdrop_late_init(void)
+{
+	if (!memdrop_mode)
+		os_info("memdrop: disabled\n");
+	else if (memdrop_mode == 2)
+		os_info("memdrop: on (flush every free via workqueue)\n");
+	else
+		os_info("memdrop: batch (1MiB / order>=%d / 100ms)\n",
+			memdrop_eager_order);
+
+	/* Enable only after workqueues are fully usable. */
+	memdrop_ready = true;
+	return 0;
+}
+late_initcall(memdrop_late_init);
+
+/*
+ * Called from __free_pages_prepare() after content is dead. Never issues
+ * host syscalls here (may run in atomic context); only queues work.
+ */
+void arch_free_page(struct page *page, int order)
+{
+	if (!memdrop_mode || !memdrop_ready)
+		return;
+
+	memdrop_queue((unsigned long)page_address(page),
+		      PAGE_SIZE << order, order);
+}
+
+static int __init uml_memdrop_setup(char *line, int *add)
+{
+	*add = 0;
+
+	if (!strcmp(line, "off")) {
+		memdrop_mode = 0;
+	} else if (!line[0] || !strcmp(line, "on")) {
+		memdrop_mode = 2;
+		memdrop_eager_order = 0;
+	} else if (!strcmp(line, "batch")) {
+		memdrop_mode = 1;
+		memdrop_eager_order = 4;
+	} else {
+		char *end;
+		unsigned long val = simple_strtoul(line, &end, 0);
+
+		if (end == line || *end != '\0' || val > 31) {
+			os_warn("memdrop: invalid '%s', using batch\n", line);
+			memdrop_mode = 1;
+			memdrop_eager_order = 4;
+		} else {
+			memdrop_mode = 1;
+			memdrop_eager_order = (int)val;
+		}
+	}
+	return 0;
+}
+__uml_setup("memdrop=", uml_memdrop_setup,
+"memdrop=off\n"
+"    Do not return freed guest pages to the host.\n"
+"memdrop=batch\n"
+"    Default. Queue frees and MADV_REMOVE from a workqueue when\n"
+"    ~1MiB is pending, a free of order >= 4 arrives, or after 100ms.\n"
+"memdrop=on\n"
+"    Flush the queue on every free (still via workqueue, not inline).\n"
+"memdrop=<eager_order>\n"
+"    Like batch, but force a flush when free order >= eager_order.\n\n"
+);
+
