+/*
+ * memdrop: return free guest physmem to the host via MADV_REMOVE.
+ *
+ * Free path sets bits in a PFN bitmap (O(1) per page, no host syscall).
+ * Worker drains PCPs, then for each set bit tries alloc_contig_range —
+ * success means the page is still free and held exclusively — punches
+ * host backing and free_contig_range. free_contig_range must not re-set
+ * bits (per-CPU worker guard).
+ *
+ * A fixed-size PFN queue overflows under large munmap (512MiB = 128k
+ * pages); a bitmap scales with physmem (1GiB guest => 32KiB bitmap).
+ *
+ * Default batch: flush when set-pages >= 1MiB or after ~100ms.
+ */
+#define MEMDROP_BATCH_PAGES	(1UL << (20 - PAGE_SHIFT))	/* 1 MiB */
+#define MEMDROP_MAX_PER_RUN	(16UL << (20 - PAGE_SHIFT))	/* 16 MiB */
+#define MEMDROP_DELAY		(HZ / 10)			/* 100 ms */
+
+static int memdrop_mode = 1; /* 0=off, 1=batch, 2=on */
+static bool memdrop_ready;
+
+static unsigned long *memdrop_bitmap;
+static unsigned long memdrop_nbits;
+static atomic_long_t memdrop_set_pages;
+static DEFINE_PER_CPU(int, memdrop_in_worker);
+
+static void memdrop_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(memdrop_dwork, memdrop_work_fn);
+
+static void memdrop_schedule(bool immediate)
+{
+	if (!memdrop_ready || !memdrop_mode || !memdrop_bitmap)
+		return;
+	if (immediate)
+		mod_delayed_work(system_wq, &memdrop_dwork, 0);
+	else if (!delayed_work_pending(&memdrop_dwork))
+		queue_delayed_work(system_wq, &memdrop_dwork, MEMDROP_DELAY);
+}
+
+static void memdrop_work_fn(struct work_struct *work)
+{
+	unsigned long bit, done = 0, ok = 0, miss = 0;
+
+	if (!memdrop_mode || !memdrop_bitmap)
+		return;
+
+	drain_all_pages(NULL);
+	this_cpu_inc(memdrop_in_worker);
+
+	for_each_set_bit(bit, memdrop_bitmap, memdrop_nbits) {
+		int err;
+
+		if (done >= MEMDROP_MAX_PER_RUN)
+			break;
+
+		if (!test_and_clear_bit(bit, memdrop_bitmap))
+			continue;
+		atomic_long_dec(&memdrop_set_pages);
+		done++;
+
+#ifdef CONFIG_CONTIG_ALLOC
+		err = alloc_contig_range(bit, bit + 1, ACR_FLAGS_NONE,
+					 GFP_KERNEL | __GFP_NOWARN |
+					 __GFP_NORETRY);
+		if (err) {
+			miss++;
+			continue;
+		}
+
+		err = os_drop_memory(page_address(pfn_to_page(bit)),
+				     PAGE_SIZE);
+		free_contig_range(bit, 1);
+
+		if (unlikely(err)) {
+			printk(KERN_WARNING
+			       "memdrop: MADV_REMOVE failed: %d - disabling\n",
+			       err);
+			memdrop_mode = 0;
+			break;
+		}
+		ok++;
+#else
+		miss++;
+#endif
+	}
+
+	this_cpu_dec(memdrop_in_worker);
+
+	if (ok || miss)
+		pr_debug("memdrop: punched %lu miss %lu remain %ld\n",
+			 ok, miss, atomic_long_read(&memdrop_set_pages));
+
+	if (memdrop_mode && atomic_long_read(&memdrop_set_pages) > 0)
+		memdrop_schedule(atomic_long_read(&memdrop_set_pages) >=
+				 MEMDROP_BATCH_PAGES);
+}
+
 /* Used during early boot */
