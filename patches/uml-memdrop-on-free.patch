+/*
+ * memdrop: return free guest physmem to the host via MADV_REMOVE.
+ *
+ * We must not MADV_REMOVE a just-freed address asynchronously — the page
+ * may already have been reallocated (that raced and crashed userspace).
+ *
+ * Safe algorithm:
+ *   1. arch_free_page() only adds to a free-page credit counter.
+ *   2. A workqueue worker bulk-allocates free pages (isolating them),
+ *      punches their host backing, then frees them back with a TLS guard
+ *      so those frees do not re-credit.
+ *   3. Alloc-all-then-free-all avoids the PCP LIFO trap of punching the
+ *      same page over and over.
+ *
+ * Default batch: flush at >= 1MiB credit or after ~100ms.
+ */
+#define MEMDROP_BATCH_PAGES	(1UL << (20 - PAGE_SHIFT))	/* 1 MiB */
+#define MEMDROP_MAX_PER_RUN	(8UL << (20 - PAGE_SHIFT))	/* 8 MiB */
+#define MEMDROP_DELAY		(HZ / 10)			/* 100 ms */
+
+static int memdrop_mode = 1; /* 0=off, 1=batch, 2=on */
+static bool memdrop_ready;
+static atomic_long_t memdrop_credit;
+
+/* Frees from the worker must not re-arm credit. */
+static DEFINE_PER_CPU(int, memdrop_in_worker);
+
+static void memdrop_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(memdrop_dwork, memdrop_work_fn);
+
+static void memdrop_schedule(bool immediate)
+{
+	if (!memdrop_ready || !memdrop_mode)
+		return;
+	if (immediate)
+		mod_delayed_work(system_wq, &memdrop_dwork, 0);
+	else if (!delayed_work_pending(&memdrop_dwork))
+		queue_delayed_work(system_wq, &memdrop_dwork, MEMDROP_DELAY);
+}
+
+static void memdrop_work_fn(struct work_struct *work)
+{
+	struct page **pages;
+	unsigned long credit, todo, got, i;
+	int err = 0;
+
+	if (!memdrop_mode)
+		return;
+
+	credit = atomic_long_xchg(&memdrop_credit, 0);
+	if (!credit)
+		return;
+
+	todo = min(credit, MEMDROP_MAX_PER_RUN);
+	pages = kvmalloc_array(todo, sizeof(*pages), GFP_KERNEL);
+	if (!pages) {
+		atomic_long_add(credit, &memdrop_credit);
+		memdrop_schedule(false);
+		return;
+	}
+
+	/* Phase 1: isolate free pages so nobody else can own them. */
+	for (got = 0; got < todo; got++) {
+		pages[got] = alloc_page(GFP_KERNEL | __GFP_NOWARN |
+					__GFP_NORETRY);
+		if (!pages[got])
+			break;
+	}
+
+	/* Put back credit we could not isolate; keep surplus credit too. */
+	if (credit > got)
+		atomic_long_add(credit - got, &memdrop_credit);
+
+	/* Phase 2: punch host backing while pages are exclusively held. */
+	for (i = 0; i < got && memdrop_mode; i++) {
+		err = os_drop_memory(page_address(pages[i]), PAGE_SIZE);
+		if (unlikely(err)) {
+			printk(KERN_WARNING
+			       "memdrop: MADV_REMOVE failed: %d - disabling\n",
+			       err);
+			memdrop_mode = 0;
+			break;
+		}
+	}
+
+	/* Phase 3: return pages to freelist without re-crediting. */
+	this_cpu_inc(memdrop_in_worker);
+	for (i = 0; i < got; i++)
+		__free_page(pages[i]);
+	this_cpu_dec(memdrop_in_worker);
+
+	kvfree(pages);
+
+	if (memdrop_mode && atomic_long_read(&memdrop_credit) > 0)
+		memdrop_schedule(atomic_long_read(&memdrop_credit) >=
+				 MEMDROP_BATCH_PAGES);
+}
+
 /* Used during early boot */
