+/*
+ * memdrop: return free guest physmem to the host via MADV_REMOVE.
+ *
+ * IMPORTANT: we must not MADV_REMOVE an address after the page may have been
+ * reallocated. Delaying a punch of the just-freed virtual address races with
+ * the buddy allocator and will corrupt live guest memory (seen as random
+ * userspace segfaults).
+ *
+ * Instead:
+ *   1. arch_free_page() only counts freed pages and kicks a workqueue.
+ *   2. The worker temporarily allocates free pages (isolating them from the
+ *      buddy), punches their host backing, then frees them back. While
+ *      isolated they cannot be given to anyone else, so the punch is safe.
+ *   3. After free-back the guest freelist is unchanged in size; the host
+ *      page is gone and the next touch zero-faults.
+ *
+ * Default ("batch") flushes when >= 1MiB of frees have been observed or
+ * after ~100ms with any pending credit. memdrop=on flushes every kick.
+ */
+#define MEMDROP_BATCH_PAGES	(1UL << (20 - PAGE_SHIFT))	/* 1 MiB */
+#define MEMDROP_MAX_PER_RUN	(16UL << (20 - PAGE_SHIFT))	/* 16 MiB */
+#define MEMDROP_DELAY		(HZ / 10)			/* 100 ms */
+
+static int memdrop_mode = 1; /* 0=off, 1=batch, 2=on */
+static bool memdrop_ready;
+static atomic_long_t memdrop_credit; /* pages freed since last flush */
+
+static void memdrop_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(memdrop_dwork, memdrop_work_fn);
+
+static void memdrop_schedule(bool immediate)
+{
+	if (!memdrop_ready || !memdrop_mode)
+		return;
+	if (immediate)
+		mod_delayed_work(system_unbound_wq, &memdrop_dwork, 0);
+	else if (!delayed_work_pending(&memdrop_dwork))
+		queue_delayed_work(system_unbound_wq, &memdrop_dwork,
+				   MEMDROP_DELAY);
+}
+
+static void memdrop_work_fn(struct work_struct *work)
+{
+	unsigned long credit, todo, i;
+
+	if (!memdrop_mode)
+		return;
+
+	credit = atomic_long_xchg(&memdrop_credit, 0);
+	if (!credit)
+		return;
+
+	todo = credit;
+	if (todo > MEMDROP_MAX_PER_RUN)
+		todo = MEMDROP_MAX_PER_RUN;
+
+	for (i = 0; i < todo && memdrop_mode; i++) {
+		struct page *page;
+		int err;
+
+		/*
+		 * Pull a free page off the buddy so nobody else can own it
+		 * while we punch. GFP_ATOMIC: we are in wq context but want
+		 * to avoid reclaim recursion; if the system is tight we
+		 * simply stop early and leave remaining credit for later.
+		 */
+		page = alloc_page(GFP_ATOMIC | __GFP_NOWARN | __GFP_NORETRY);
+		if (!page) {
+			/* Put unused credit back. */
+			atomic_long_add(todo - i, &memdrop_credit);
+			break;
+		}
+
+		err = os_drop_memory(page_address(page), PAGE_SIZE);
+		__free_page(page);
+
+		if (unlikely(err)) {
+			printk(KERN_WARNING
+			       "memdrop: MADV_REMOVE failed: %d - disabling\n",
+			       err);
+			memdrop_mode = 0;
+			break;
+		}
+	}
+
+	/* More credit arrived while we ran, or we deferred some. */
+	if (memdrop_mode && atomic_long_read(&memdrop_credit) > 0)
+		memdrop_schedule(atomic_long_read(&memdrop_credit) >=
+				 MEMDROP_BATCH_PAGES);
+}
+
 /* Used during early boot */
 static unsigned long brk_end;
 
