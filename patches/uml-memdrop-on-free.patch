+/*
+ * memdrop: return free guest physmem to the host via MADV_REMOVE.
+ *
+ * Punching a just-freed virtual address later is a use-after-reuse race
+ * (the page may already belong to someone else). Isolating a *random*
+ * free page and punching it does not help either: dirty high-water pages
+ * stay resident while cold free pages get punched.
+ *
+ * Correct approach: remember the PFN that was freed. The worker tries
+ * alloc_contig_range() on that PFN; success means the page is still free
+ * and now exclusively held, so MADV_REMOVE is safe. Then free_contig_range
+ * returns it to the freelist with host backing gone.
+ *
+ * Requires CONFIG_CONTIG_ALLOC (enabled in containers.config).
+ *
+ * Default batch: flush when pending >= 1MiB or after ~100ms.
+ * Free path only enqueues under a spinlock — no host syscall there.
+ */
+#define MEMDROP_MAX_RANGES	512
+#define MEMDROP_BATCH_PAGES	(1UL << (20 - PAGE_SHIFT)) /* 1 MiB */
+#define MEMDROP_DELAY		(HZ / 10)		  /* 100 ms */
+
+struct memdrop_range {
+	unsigned long pfn;
+	unsigned int  nr; /* page count */
+};
+
+static int memdrop_mode = 1; /* 0=off, 1=batch, 2=on */
+static bool memdrop_ready;
+
+static struct memdrop_range memdrop_q[MEMDROP_MAX_RANGES];
+static unsigned int memdrop_head, memdrop_tail, memdrop_count;
+static unsigned long memdrop_pending_pages;
+static DEFINE_SPINLOCK(memdrop_lock);
+
+static void memdrop_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(memdrop_dwork, memdrop_work_fn);
+
+static void memdrop_schedule(bool immediate)
+{
+	if (!memdrop_ready || !memdrop_mode)
+		return;
+	if (immediate)
+		mod_delayed_work(system_wq, &memdrop_dwork, 0);
+	else if (!delayed_work_pending(&memdrop_dwork))
+		queue_delayed_work(system_wq, &memdrop_dwork, MEMDROP_DELAY);
+}
+
+static bool memdrop_dequeue(struct memdrop_range *out)
+{
+	unsigned long flags;
+	bool ok = false;
+
+	spin_lock_irqsave(&memdrop_lock, flags);
+	if (memdrop_count) {
+		*out = memdrop_q[memdrop_head];
+		memdrop_head = (memdrop_head + 1) % MEMDROP_MAX_RANGES;
+		memdrop_count--;
+		memdrop_pending_pages -= out->nr;
+		ok = true;
+	}
+	spin_unlock_irqrestore(&memdrop_lock, flags);
+	return ok;
+}
+
+static void memdrop_work_fn(struct work_struct *work)
+{
+	struct memdrop_range r;
+	unsigned int handled = 0;
+
+	if (!memdrop_mode)
+		return;
+
+	/*
+	 * Drain up to one batch worth per invocation so we do not monopolize
+	 * a workqueue thread. Reschedule if more remains.
+	 */
+	while (handled < MEMDROP_BATCH_PAGES && memdrop_dequeue(&r)) {
+		unsigned long start = r.pfn;
+		unsigned long end = r.pfn + r.nr;
+		int err;
+
+		/*
+		 * Isolate only if still free. Failure is normal (page was
+		 * reused) — just skip; host keeps that page until a later
+		 * free of it is observed again.
+		 */
+		err = alloc_contig_range(start, end, ACR_FLAGS_NONE,
+					 GFP_KERNEL | __GFP_NOWARN |
+					 __GFP_NORETRY);
+		if (err) {
+			handled += r.nr;
+			continue;
+		}
+
+		err = os_drop_memory(page_address(pfn_to_page(start)), r.nr << PAGE_SHIFT);
+		free_contig_range(start, r.nr);
+
+		if (unlikely(err)) {
+			printk(KERN_WARNING
+			       "memdrop: MADV_REMOVE failed: %d - disabling\n",
+			       err);
+			memdrop_mode = 0;
+			break;
+		}
+		handled += r.nr;
+	}
+
+	if (memdrop_mode) {
+		unsigned long flags;
+		bool more;
+
+		spin_lock_irqsave(&memdrop_lock, flags);
+		more = memdrop_count > 0;
+		spin_unlock_irqrestore(&memdrop_lock, flags);
+		if (more)
+			memdrop_schedule(true);
+	}
+}
+
+static void memdrop_enqueue(unsigned long pfn, unsigned int nr)
+{
+	unsigned long flags;
+	bool immediate = false;
+	unsigned int last;
+
+	spin_lock_irqsave(&memdrop_lock, flags);
+
+	if (!memdrop_mode)
+		goto out;
+
+	/* Merge with previous range if contiguous. */
+	if (memdrop_count) {
+		last = (memdrop_tail + MEMDROP_MAX_RANGES - 1) %
+			MEMDROP_MAX_RANGES;
+		if (memdrop_q[last].pfn + memdrop_q[last].nr == pfn) {
+			memdrop_q[last].nr += nr;
+			memdrop_pending_pages += nr;
+			goto queued;
+		}
+	}
+
+	if (memdrop_count >= MEMDROP_MAX_RANGES) {
+		/* Drop oldest to make room; better than blocking free path. */
+		memdrop_pending_pages -= memdrop_q[memdrop_head].nr;
+		memdrop_head = (memdrop_head + 1) % MEMDROP_MAX_RANGES;
+		memdrop_count--;
+	}
+
+	memdrop_q[memdrop_tail].pfn = pfn;
+	memdrop_q[memdrop_tail].nr = nr;
+	memdrop_tail = (memdrop_tail + 1) % MEMDROP_MAX_RANGES;
+	memdrop_count++;
+	memdrop_pending_pages += nr;
+
+queued:
+	if (memdrop_mode == 2 ||
+	    memdrop_pending_pages >= MEMDROP_BATCH_PAGES ||
+	    memdrop_count >= (MEMDROP_MAX_RANGES * 3 / 4))
+		immediate = true;
+
+out:
+	spin_unlock_irqrestore(&memdrop_lock, flags);
+	memdrop_schedule(immediate);
+}
+
 /* Used during early boot */
 static unsigned long brk_end;
 
@@ -84,6 +254,62 @@ void __init mem_init(void)
