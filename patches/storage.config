# Kernel config fragment: extra storage support for UML guests.
#
# Applied via `scripts/kconfig/merge_config.sh` on top of containers.config.
# Everything here is reachable through /dev/ubd* or a loop device on top of a
# ubd-backed file (CONFIG_BLK_DEV_LOOP is already on in the base config), so the
# usual workflow is:
#
#     losetup -f --show /path/to/image.img     # or: mount -o loop ...
#     mount /dev/loop0 /mnt
#
# NOTE on ZFS: OpenZFS is CDDL-licensed and is *not* part of the mainline
# kernel tree, so no Kconfig symbol can enable it. It has to be built
# out-of-tree against these kernel sources (see README, "ZFS on UML").
# What this fragment does is guarantee the prerequisites for that build
# (MODULES/KALLSYMS/zlib) and enable BTRFS as the in-tree copy-on-write
# filesystem with the closest feature overlap (snapshots, subvolumes,
# checksums, send/receive, RAID0/1/10).

# === Squashfs — read-only compressed images (container/OCI layers, initrd) ===
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
# Decompress straight into the page cache; skips a memcpy and the single-buffer
# lock. Pairs with SMP, which these builds enable (NR_CPUS=64).
CONFIG_SQUASHFS_CHOICE_DECOMP_BY_MOUNT=y
CONFIG_SQUASHFS_MOUNT_DECOMP_THREADS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_4K_DEVBLK_SIZE=y
CONFIG_SQUASHFS_FRAGMENT_CACHE_SIZE=3

# === FAT / VFAT — EFI system partitions, USB images, firmware blobs ===
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"

# VFAT is useless without NLS: long filenames are UTF-16 on disk and need a
# charset to translate. Without NLS_UTF8 a `mount -o iocharset=utf8` fails.
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_850=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_ISO8859_15=y
CONFIG_NLS_UTF8=y

# === XFS ===
CONFIG_XFS_FS=y
CONFIG_XFS_SUPPORT_V4=y
CONFIG_XFS_SUPPORT_ASCII_CI=y
CONFIG_XFS_QUOTA=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_XFS_RT=y
CONFIG_XFS_ONLINE_SCRUB=y
# XFS_DEBUG/XFS_WARN stay off: they add asserts that panic on conditions a
# normal guest can hit, and they slow the metadata paths down.

# === BTRFS — in-tree CoW filesystem (see the ZFS note at the top) ===
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# BTRFS_FS_CHECK_INTEGRITY / _RUN_SANITY_TESTS / _DEBUG deliberately left off.

# === ISO9660 / UDF — mounting .iso images over loop ===
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y

# === device-mapper — the layer LVM2, cryptsetup and dm-verity sit on ===
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_DM_BUILTIN=y
CONFIG_DM_BUFIO=y
CONFIG_DM_UEVENT=y
# LVM2: linear/striped come from BLK_DEV_DM itself; these cover the rest.
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_MIRROR=y
CONFIG_DM_RAID=y
CONFIG_DM_ZERO=y
CONFIG_DM_CACHE=y
CONFIG_DM_CACHE_SMQ=y
CONFIG_DM_WRITECACHE=y
CONFIG_DM_ERA=y
CONFIG_DM_CLONE=y
CONFIG_DM_DELAY=y
CONFIG_DM_FLAKEY=y
CONFIG_DM_MULTIPATH=y
# LUKS / dm-verity / dm-integrity
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_INTEGRITY=y

# === md / mdadm software RAID (LVM can layer on top) ===
CONFIG_BLK_DEV_MD=y
# MD_BITMAP is the 6.18+ name; MD_BITMAP_FILE is the older/deprecated one.
# Both are listed so the fragment works across every kernel these workflows
# build; olddefconfig drops whichever does not exist.
CONFIG_MD_BITMAP=y
CONFIG_MD_BITMAP_FILE=y
CONFIG_MD_AUTODETECT=y
CONFIG_MD_LINEAR=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
CONFIG_MD_RAID456=y

# === crypto needed by dm-crypt/LUKS2 defaults ===
# cryptsetup's default is aes-xts-plain64 + sha256; ESSIV covers older headers.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ESSIV=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_XXHASH=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# === quota (XFS_QUOTA and ext4 quota both want the generic layer) ===
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y
CONFIG_QFMT_V2=y

# === compression / crc libs the above select; asserted so a stale .config
# === can't leave them off and silently disable a decompressor.
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_XZ_DEC=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_CRC32=y
CONFIG_CRC16=y
CONFIG_LIBCRC32C=y

# === out-of-tree module builds (OpenZFS/DKMS need these) ===
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# Unsigned out-of-tree modules must be loadable.
# Written in canonical "is not set" form so merge_config.sh does not flag these
# as value changes on every run.
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
