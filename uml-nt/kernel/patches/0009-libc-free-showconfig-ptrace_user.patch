+ * uml-nt (CONFIG_OS_WINDOWS): both functions are ptrace-mode seams (D6);
+ * the NT backend has no ptrace and no host errno — the kernel-side
+ * callers only exist on the ptrace path, so these PANIC if ever reached.
  */
+void stub_panic(const char *why) __attribute__((noreturn));
 
-#include <errno.h>
-#include <ptrace_user.h>
-
-int ptrace_getregs(long pid, unsigned long *regs_out)
+int init_registers(int pid)
 {
-	if (ptrace(PTRACE_GETREGS, pid, 0, regs_out) < 0)
-		return -errno;
-	return 0;
+	stub_panic("ptrace_user.c: init_registers — no ptrace on NT (D6)");
 }
 
-int ptrace_setregs(long pid, unsigned long *regs)
+int ptrace_setregs(int pid, unsigned long *regs)
 {
-	if (ptrace(PTRACE_SETREGS, pid, 0, regs) < 0)
-		return -errno;
-	return 0;
+	stub_panic("ptrace_user.c: ptrace_setregs — no ptrace on NT (D6)");
 }
