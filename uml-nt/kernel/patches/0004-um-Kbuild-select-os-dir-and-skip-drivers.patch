--- a/arch/um/Kbuild
+++ b/arch/um/Kbuild
@@ -1,3 +1,13 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
-obj-y += kernel/ drivers/ os-Linux/
+# uml-nt: pick the os- backend dir at config time (D4). $(src)-style dir
+# Makefiles then own their objects.
+os-dir := os-Linux
+ifeq ($(CONFIG_OS_WINDOWS),y)
+os-dir := os-Windows
+endif
+
+# M3.5: drivers/ builds under OS_WINDOWS too — arch/um/drivers/Makefile
+# self-filters to ubd's kernel side only (D1: the chan/console stack is
+# libc-host code; its port is the M3.6 console work).
+obj-y += kernel/ drivers/ $(os-dir)/
