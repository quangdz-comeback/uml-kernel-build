+/* D21 SKELETON (proposed — NOT landed): max runs ONE backing span
+ * may have. The D12 backend builds a contiguous buddy block of
+ * order RUN_ORDER(4) + ceil(log2(nruns)); kernel MAX_PAGE_ORDER=10
+ * caps the order, i.e. 64 runs (1 MiB) per span. python3.11's four
+ * overlapping PT_LOADs merge to 109 runs = order 11 = the
+ * deterministic UML_NT_ELF_NOMEM (Astra's audit, run 36878030578).
+ * The loader will allocate PER-CHUNK spans instead of one; this is
+ * the reviewable, unit-tested chunking math. */
+#define UML_NT_ELF_SPAN_MAX_RUNS 64
+
+/* Fill out[] with the per-chunk run counts for a contiguous region
+ * of `nruns` runs (greedy full chunks). Returns the chunk count, or
+ * -1 on bad input / max_out too small. Pure function. */
+int uml_nt_elf_span_plan(long long nruns, int *out, int max_out);
