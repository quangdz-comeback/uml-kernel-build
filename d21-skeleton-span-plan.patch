+/* D21 SKELETON (proposed — NOT landed): the chunking math for
+ * per-chunk span allocation (see UML_NT_ELF_SPAN_MAX_RUNS in
+ * elf.h). Pure function — unit-tested in test_elf.c. The loader's
+ * alloc loop will consume this per merged region: one contiguous
+ * buddy block per chunk instead of one order-11 monster. */
+int uml_nt_elf_span_plan(long long nruns, int *out, int max_out)
+{
+	int n = 0;
+
+	if (nruns <= 0 || max_out <= 0 || out == (int *)0)
+		return -1;
+	while (nruns > 0) {
+		long long c = (nruns > UML_NT_ELF_SPAN_MAX_RUNS) ?
+			      UML_NT_ELF_SPAN_MAX_RUNS : nruns;
+
+		if (n == max_out)
+			return -1;
+		out[n++] = (int)c;
+		nruns -= c;
+	}
+	return n;
+}
