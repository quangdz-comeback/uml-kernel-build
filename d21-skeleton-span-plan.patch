+/* D21 SKELETON: the per-chunk span plan — greedy 64-run chunks, the
+ * math the loader's alloc loop will consume (python3.11's 109-run
+ * merged region = the order-11 NOMEM it must dissolve). */
+static void test_span_plan(void)
+{
+	int out[8];
+
+	/* 109 runs (python3.11 merged): [64, 45]. */
+	CHECK(uml_nt_elf_span_plan(109, out, 8) == 2);
+	CHECK(out[0] == 64);
+	CHECK(out[1] == 45);
+
+	/* Exact multiples and single chunks. */
+	CHECK(uml_nt_elf_span_plan(64, out, 8) == 1 && out[0] == 64);
+	CHECK(uml_nt_elf_span_plan(1, out, 8) == 1 && out[0] == 1);
+	CHECK(uml_nt_elf_span_plan(128, out, 8) == 2);
+
+	/* Max-out too small: -1, no overwrite. */
+	CHECK(uml_nt_elf_span_plan(129, out, 2) == -1);
+
+	/* Bad inputs. */
+	CHECK(uml_nt_elf_span_plan(0, out, 8) == -1);
+	CHECK(uml_nt_elf_span_plan(-4, out, 8) == -1);
+	CHECK(uml_nt_elf_span_plan(16, NULL, 8) == -1);
+}
